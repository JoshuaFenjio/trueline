# Copy to .env.local (gitignored). These are read server-side by the data layer.
# Use the ANON public key here — NOT the service key. The service key must never
# be present in the web app.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Public origin for every absolute URL we emit: sitemap, robots, canonical and
# OG/twitter metadata, share links. Unset falls back to the current Vercel
# production alias (see lib/site.ts). At custom-domain cutover, change this and
# nothing else. A trailing slash is fine — it gets stripped.
NEXT_PUBLIC_SITE_URL=https://trueline-azure.vercel.app
