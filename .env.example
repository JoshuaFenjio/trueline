# ---------------------------------------------------------------------------
# Trueline environment.
# Copy this file to ".env" and fill it in:   cp .env.example .env
# NEVER commit .env — it is gitignored.
#
# If SUPABASE_URL + SUPABASE_SERVICE_KEY are blank, the Python pipeline falls
# back to a local SQLite file (trueline.db) and runs with zero setup.
# ---------------------------------------------------------------------------

# --- Supabase (server-side / Python pipeline + migration) ------------------
# Project Settings -> API -> Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Project Settings -> API -> service_role secret key. FULL ACCESS. Keep secret.
# Used by pipeline.py and migrate.py only. Never shipped to the browser.
SUPABASE_SERVICE_KEY=

# Backwards-compat alias (older scripts read SUPABASE_KEY). Optional.
SUPABASE_KEY=
